{"html": [{"t": "<div><div class=\"p\">&nbsp; &nbsp; FIJA PORCENTAJE DE COINCIDENCIA ENTRE EL TRAZADO TRONCAL Y EL CONJUNTO DE TRAZADOS DENOMINADOS VARIANTES N&#xFA;m. 1 exenta.- Concepci&#xF3;n, 6 de Enero de 1992.- Vistos: El art&#xED;culo 3&#xB0; de la Ley N&#xB0; 18.696, el Art&#xED;culo 10 de la Ley 19.040 y las facultades que me confiere el D.S. N&#xB0; 72 de 1991 del Ministerio de Transportes y Telecomunicaciones, Subsecretar&#xED;a de Transportes, Resuelvo:</div><br></div>", "i": 7200693}, {"t": "<div><div class=\"p\">&nbsp; &nbsp; Determ&#xED;nase, para los efectos del D.S. N&#xB0; 72/91, del Ministerio de Transportes y Telecomunicaciones, Subsecretar&#xED;a de <span class=\"n\" id=\"n_0\"><a href=\"navegar?idNorma=38129&amp;idParte=7200950&amp;idVersion=1995-06-10\">Resoluci&#xF3;n 53 EXENTA,<br>TRANSPORTES<br>D.O. 10.06.1995</a></span>Transportes que en las ciudades de la VIII Regi&#xF3;n, las variantes de los trazados troncales que se se&#xF1;alan deben coincidir con &#xE9;stos en un 70% como m&#xED;nimo.</div></div>", "i": 7200694, "v": ["MODIFICACION"]}, {"t": "<div><div class=\"p\">&nbsp; &nbsp; An&#xF3;tese y publ&#xED;quese.- Mauricio Leiva Chamorro, Secretario Regional Ministerial Transportes y Telecomunicaciones, VIII Regi&#xF3;n del B&#xED;o B&#xED;o. </div></div>", "i": 7200695}], "proyectos": [], "otrosSistemas": [], "jurisprudencia": [], "doctrina": [], "metadatos": {"tiene_notas": true, "tipos_numeros": [{"tipo": "3", "numero": "1 EXENTA", "abreviacion": "RES", "descripcion": "Resolucion", "compuesto": "RES-1 EXENTA"}], "organismos": ["MINISTERIO DE TRANSPORTES Y TELECOMUNICACIONES"], "titulo_norma": "FIJA PORCENTAJE DE COINCIDENCIA ENTRE EL TRAZADO TRONCAL Y EL CONJUNTO DE TRAZADOS DENOMINADOS VARIANTES", "fuente": "Diario Oficial", "resumenes": [], "materias": [], "terminos_libres": ["LOCOMOCION COLECTIVA", "VIII REGION", "VEHICULO", "MOTORIZADO", "TRAZADOS TRONCALES", "VARIANTES", "PORCENTAJE", "VARIACION", "FIJACION"], "categorias_norma":