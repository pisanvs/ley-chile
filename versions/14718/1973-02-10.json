{"html": [{"t": "<div><div class=\"p\">APRUEBA REGLAMENTO DE LA LEY N.o 11,766</div><br><div class=\"p\">&nbsp; &nbsp; N&#xFA;m. 626.- Santiago, 16 de febrero de 1955.- Visto: lo dispuesto en la ley 11.766, de 30 de diciembre de 1954, y la facultad que me otorga el art&#xED;culo 72&#xB0;, N&#xB0; 2, de la Constituci&#xF3;n Pol&#xED;tica del Estado,</div><br><div class=\"p\">&nbsp; &nbsp; Decreto:</div><br><div class=\"p\">&nbsp; &nbsp; Apru&#xE9;base el siguiente reglamento para la aplicaci&#xF3;n de la ley 11.766, sobre &quot;Fondo para la construcci&#xF3;n y dotaci&#xF3;n de establecimientos de la Educaci&#xF3;n P&#xFA;blica&quot;:</div><br><br></div>", "i": 8995048}], "proyectos": [], "otrosSistemas": [], "jurisprudencia": [], "doctrina": [], "metadatos": {"tiene_notas": false, "tipos_numeros": [{"tipo": "2", "numero": "626", "abreviacion": "DTO", "descripcion": "Decreto", "compuesto": "DTO-626"}], "organismos": ["MINISTERIO DE EDUCACIÓN PÚBLICA"], "titulo_norma": "APRUEBA REGLAMENTO DE LA LEY N.O 11,766", "fuente": "", "resumenes": [], "materias": [], "terminos_libres": [], "categorias_norma": [], "nombres_uso_comun": [], "paises_tratados": [], "organismos_tratados": [], "observaciones": [], "derogacion_tacita": [], "derogado": false, "fecha_promulgacion": "1955-02-16", "doble_articulado": false, "id_norma": "14718", "tipo_version": "1", "tipo_version_s": "Intermedio", "fecha_publicacion": "1955-04-05", "vigencias": [{"desde": "1976-03-13", "hasta": "", "tipo_version": "2", "tipo_version_s": "Última Versión"}, {"desde": "1973-02-10", "hasta": "1976-03-12", "tipo_version": "1", "tipo_version_s": "Intermedio"}], "vigencia": {"inicio_vigencia": "1973-02-10", "fin_vigencia": "1976-03-12"}, "vigencias_version_norma": [{"inicio_vigencia": "1973-02-10", "fin_vigencia": "", "tipo_version": "3"}], "eventos_pendientes": [], "vinculaciones": [{"text": "MODIFICACION", "url_part": "modificacion"}], "fecha_version": "1973-02-10", "fecha_actualizacion_texto": "1976-03-13", "ti