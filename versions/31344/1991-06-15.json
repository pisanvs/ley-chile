{"html": [{"t": "<div><div class=\"p\">&nbsp; &nbsp; DESIGNA COMO RECEPTORES JUDICIALES A FUNCIONARIOS QUE INDICA</div><div class=\"p\">&nbsp; &nbsp; N&#xFA;m. 119.- Santiago, 2 de Mayo de 1991.- Vistos: Lo dispuesto en el art&#xED;culo 11 del decreto ley N&#xB0; 2.974 de 1979.</div><div class=\"p\">&nbsp; &nbsp; Resuelvo:</div><br></div>", "i": 8949213}, {"t": "<div><div class=\"p\">&nbsp; &nbsp; Des&#xED;gnase como Receptores Judiciales para que permanentemente practiquen las actuaciones inherentes a ese cargo en los juicios que se tramitan ante los Juzgados de Polic&#xED;a Local, en conformidad a las disposiciones del decreto ley citado, en la VIII Regi&#xF3;n, a los siguientes funcionarios:</div><div class=\"p\"> - JoseRam&#xED;rez P&#xE9;rez</div><div class=\"p\"> - Luis Zapata Poblete</div><div class=\"p\"> - Rodrigo Leiva Lobos</div><div class=\"p\"> - Jos&#xE9; Echeverr&#xED;a Zambrano</div><br></div>", "i": 8949214}, {"t": "<div><div class=\"p\">&nbsp; &nbsp; T&#xF3;mese raz&#xF3;n, an&#xF3;tese, comun&#xED;quese y publ&#xED;quese en el Diario Oficial.- Hugo Ortega Tello, Director Nacional.</div><br></div>", "i": 8949215}], "proyectos": [], "otrosSistemas": [], "jurisprudencia": [], "doctrina": [], "metadatos": {"tiene_notas": false, "tipos_numeros": [{"tipo": "3", "numero": "119", "abreviacion": "RES", "descripcion": "Resolucion", "compuesto": "RES-119"}], "organismos": ["MINISTERIO DE AGRICULTURA", "INSTITUTO DE DESARROLLO AGROPECUARIO"], "titulo_norma": "DESIGNA COMO RECEPTORES JUDICIALES A FUNCIONARIOS QUE INDICA", "fuente": "Diario Oficial", "resumenes": [], "materias": [], "terminos_libres": ["INSTITUTO DESARROLLO AGROPECUARIO", "VIII REGION", "JOSE", "RAMIREZ PEREZ", "LUIS ZAPATA POBLETE", "RODRIGO LEIVA LOBOS", "JOSE ECHEVERRIA ZAMBRANO", "RECEPTOR JUDICIAL", "NOMBRAMIENTO"], "categorias_norma": [], "nombres_uso_comun": [], "paises_tratados": [], "organismos_tratados": [], "observaciones": [], "derogacion_tacita": [], "derogado": false, "fecha_promu