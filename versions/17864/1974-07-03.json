{"html": [{"t": "<div><div class=\"p\">&nbsp; &nbsp; REGLAMENTO DE LA LEY 17.383, DE 6 DE NOVIEMBRE DE 1970, QUE CREO EL COLEGIO DE LABORATORISTAS DENTALES </div><div class=\"p\">&nbsp; &nbsp; SANTIAGO, 21 de octubre de 1971.- Hoy se decret&#xF3; lo que sigue:</div><div class=\"p\">&nbsp; &nbsp; N&#xB0; 1455.- Vistos lo dispuesto en la Ley N&#xB0; 17.383, de 6 de noviembre de 1970, y en uso de la facultad que me confiere el N&#xB0; 2 del Art&#xED;culo 72 de la Constituci&#xF3;n Pol&#xED;tica del Estado.</div><br><div class=\"p\">&nbsp; &nbsp; DECRETO:</div><br><div class=\"p\">&nbsp; &nbsp; Apru&#xE9;base el siguiente &quot;Reglamento del Colegio de Laboratoristas Dentales&quot;.</div><br><br></div>", "i": 8996982}], "proyectos": [], "otrosSistemas": [], "jurisprudencia": [], "doctrina": [], "metadatos": {"tiene_notas": false, "tipos_numeros": [{"tipo": "2", "numero": "1455", "abreviacion": "DTO", "descripcion": "Decreto", "compuesto": "DTO-1455"}], "organismos": ["MINISTERIO DE JUSTICIA"], "titulo_norma": "REGLAMENTO DE LA LEY 17.383, DE 6 DE NOVIEMBRE DE 1970, QUE CREO EL COLEGIO DE LABORATORISTAS DENTALES", "fuente": "", "resumenes": [], "materias": [], "terminos_libres": [], "categorias_norma": [], "nombres_uso_comun": [], "paises_tratados": [], "organismos_tratados": [], "observaciones": [], "derogacion_tacita": [], "derogado": false, "fecha_promulgacion": "1971-10-21", "doble_articulado": false, "id_norma": "17864", "tipo_version": "1", "tipo_version_s": "Intermedio", "fecha_publicacion": "1972-07-11", "vigencias": [{"desde": "1990-11-09", "hasta": "", "tipo_version": "2", "tipo_version_s": "Última Versión"}, {"desde": "1974-07-03", "hasta": "1990-11-08", "tipo_version": "1", "tipo_version_s": "Intermedio"}], "vigencia": {"inicio_vigencia": "1974-07-03", "fin_vigencia": "1990-11-08"}, "vigencias_version_norma": [{"inicio_vigencia": "1974-07-03", "fin_vigencia": "", "tipo_version": "3"}], "eventos_pendientes": [], "vinculaciones": [{"text": "REGLAMENTO", "url_p