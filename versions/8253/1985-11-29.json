{"html": [{"t": "<div><div class=\"p\">&nbsp; &nbsp; APRUEBA EL REGLAMENTO PARA LA APLICACION DEL DECRETO LEY N&#xB0; 3.500, de 1980</div><div class=\"p\">&nbsp; &nbsp; Santiago, 1&#xB0; de Abril de 1981.- Hoy se dict&#xF3; lo siguiente:</div><div class=\"p\">&nbsp; &nbsp; N&#xFA;m. 50.- Visto: lo dispuesto en el decreto ley N&#xB0; 3.500, de 1980, y la facultad contenida en el art&#xED;culo 32 N&#xB0; 8&#xB0; de la Constituci&#xF3;n Pol&#xED;tica de la Rep&#xFA;blica de Chile</div><div class=\"p\">&nbsp; &nbsp; Decreto:</div><div class=\"p\">&nbsp; &nbsp; Apru&#xE9;base el siguiente Reglamento para la aplicaci&#xF3;n del decreto ley N&#xB0; 3.500, de 1980:</div><br><div class=\"np\" id=\"np0\"><a href=\"#rnp0\">NOTA:</a> <br>&nbsp; &nbsp; &nbsp; El DTO 100, Trabajo, publicado el 08.01.1988, reemplaz&#xF3; el presente texto.<br></div></div>", "i": 8963340}], "proyectos": [], "otrosSistemas": [], "jurisprudencia": [], "doctrina": [], "metadatos": {"tiene_notas": true, "tipos_numeros": [{"tipo": "2", "numero": "50", "abreviacion": "DTO", "descripcion": "Decreto", "compuesto": "DTO-50"}], "organismos": ["MINISTERIO DEL TRABAJO"], "titulo_norma": "APRUEBA EL REGLAMENTO PARA LA APLICACION DEL DECRETO LEY N° 3.500, DE 1980", "fuente": "", "resumenes": [], "materias": [], "terminos_libres": [], "categorias_norma": [], "nombres_uso_comun": [], "paises_tratados": [], "organismos_tratados": [], "observaciones": [], "derogacion_tacita": [], "derogado": false, "fecha_promulgacion": "1979-04-01", "doble_articulado": false, "id_norma": "8253", "tipo_version": "1", "tipo_version_s": "Intermedio", "fecha_publicacion": "1981-04-30", "vigencias": [{"desde": "1997-09-23", "hasta": "", "tipo_version": "2", "tipo_version_s": "Última Versión"}, {"desde": "1988-01-08", "hasta": "1997-09-22", "tipo_version": "1", "tipo_version_s": "Intermedio"}, {"desde": "1985-11-29", "hasta": "1988-01-07", "tipo_version": "1", "tipo_version_s": "Intermedio"}], "vigencia": {"inicio_vigencia": "1985-11-29"