{"html": [{"t": "<div><div class=\"p\">&nbsp; &nbsp; Lei n&#xFA;m. 2,114, que dispone que la plata en barra con lei de cinco d&#xE9;cimos de fino o m&#xE9;nos pagar&#xE1; un derecho de esportacion de 40 por ciento.</div><div class=\"p\">&nbsp; &nbsp; Lei n&#xFA;m. 2,114.-</div><div class=\"p\">&nbsp; &nbsp; Por cuanto el Congreso Nacional ha dado su aprobacion al siguiente</div><div class=\"p\">&nbsp; &nbsp; PROYECTO DE LEI:</div><br></div>", "i": 5952813}, {"t": "<div><div class=\"p\">&nbsp; &nbsp; ARTICULO UNICO. La plata en barra con lei de cinco d&#xE9;cimos o m&#xE9;nos, pagar&#xE1; un derecho de esportacion de cuarenta por ciento sobre su valor.</div><br></div>", "i": 5952814}, {"t": "<div><div class=\"p\">&nbsp; &nbsp; I por cuanto, oido el Consejo de Estado he tenido a bien aprobarlo i sancionarlo; por tanto, prom&#xFA;lguese i ll&#xE9;vese a efecto como lei de la Rep&#xFA;blica.</div><div class=\"p\">&nbsp; &nbsp; Santiago, 10 de Agosto de 1908.- PEDRO MONTT.- Enrique A. Rodr&#xED;guez.</div><br></div>", "i": 5952815}], "proyectos": [], "otrosSistemas": [], "jurisprudencia": [], "doctrina": [], "metadatos": {"tiene_notas": false, "tipos_numeros": [{"tipo": "1", "numero": "2114", "abreviacion": "LEY", "descripcion": "Ley", "compuesto": "LEY-2114"}], "organismos": ["MINISTERIO DE HACIENDA"], "titulo_norma": "LEI NUM. 2,114, QUE DISPONE QUE LA PLATA EN BARRA CON LEI DE CINCO DECIMOS DE FINO O MENOS PAGARA UN DERECHO DE ESPORTACION DE 40 POR CIENTO.", "fuente": "Diario Oficial", "resumenes": [], "materias": [], "terminos_libres": ["PLATA BARRA", "DERECHO EXPORTACION"], "categorias_norma": [], "nombres_uso_comun": [], "paises_tratados": [], "organismos_tratados": [], "observaciones": [], "derogacion_tacita": [], "derogado": true, "fecha_promulgacion": "1908-08-10", "fecha_derogacion": "1936-09-07", "doble_articulado": false, "id_norma": "23128", "numero_fuente": "9160", "tipo_version": "0", "tipo_version_s": "Texto Original", "fecha_publicacion": "1908-08-13", "