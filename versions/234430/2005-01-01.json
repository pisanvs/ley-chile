{"html": [{"t": "<div><br></div>", "i": null}, {"t": "<div><div class=\"p\">&nbsp; &nbsp;  Reactual&#xED;zase en 7,5% la cantidad expresada en d&#xF3;lares de los Estados Unidos de Am&#xE9;rica, a que se refiere el art&#xED;culo 46&#xBA; de la Ley sobre Impuesto a las Ventas y Servicios, la que queda en el siguiente monto:</div><br><div class=\"p\">&nbsp; &nbsp;  De US$ 18.873,02.- queda en US$20.288,49.</div><div class=\"p\">&nbsp; &nbsp;  El presente decreto regir&#xE1; a contar del 1&#xBA; de enero del a&#xF1;o 2005.</div><br></div>", "i": 7317461, "v": ["MODIFICACION"]}], "proyectos": [], "otrosSistemas": [], "jurisprudencia": [], "doctrina": [], "metadatos": {"tiene_notas": false, "tipos_numeros": [{"tipo": "2", "numero": "824 EXENTO", "abreviacion": "DTO", "descripcion": "Decreto", "compuesto": "DTO-824 EXENTO"}], "organismos": ["MINISTERIO DE HACIENDA"], "titulo_norma": "REACTUALIZA EN 7,5% LAS CANTIDADES EXPRESADAS EN DOLARES DE LOS ESTADOS UNIDOS DE AMERICA, A QUE SE REFIERE EL ARTICULO 46º DE LA LEY SOBRE IMPUESTO A LAS VENTAS Y SERVICIOS", "fuente": "Diario Oficial", "resumenes": [], "materias": [], "terminos_libres": ["IMPORTACION", "VEHICULOS MOTORIZADOS", "PARTES Y PIEZAS", "IMPUESTO A LAS VENTAS Y SERVICIOS", "IVA", "IMPUESTO ADICIONAL", "VALOR EN DOLARES USA", "REACTUALIZACION"], "categorias_norma": [], "nombres_uso_comun": [], "paises_tratados": [], "organismos_tratados": [], "observaciones": [], "derogacion_tacita": [], "derogado": false, "doble_articulado": false, "id_norma": "234430", "numero_fuente": "38054", "fecha_publicacion": "2005-01-07", "vigencias": [{"desde": "2005-01-07", "hasta": "", "tipo_version": "2", "tipo_version_s": "Última Versión"}, {"desde": "2005-01-01", "hasta": "2005-01-06", "tipo_version": "0", "tipo_version_s": "Texto Original"}], "vigencia": {"fin_vigencia": ""}, "vigencias_version_norma": [], "eventos_pendientes": [], "vinculaciones": [{"text": "MODIFICACION", "url_part": "modificacion"}], "fecha_actualizacion_texto": "