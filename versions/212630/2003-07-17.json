{"html": [{"t": "<div><div class=\"p\">&#xA0;</div></div>", "i": 8045907}, {"t": "<div><div class=\"p\">&nbsp; &nbsp;  Por resoluci&#xF3;n exenta N&#xBA; 1.605, de 11 de julio de 2003, de esta Subsecretar&#xED;a, rectif&#xED;case el numeral 1&#xBA; de la resoluci&#xF3;n N&#xBA; 1.933 de 1999, de esta Subsecretar&#xED;a, que autoriz&#xF3; a SOCIEDAD PESCA MARINA LIMITADA, para ampliar las actividades pesqueras extractivas con la nave &quot;Gringo&quot;, en el sentido de se&#xF1;alar que la matr&#xED;cula de la se&#xF1;alada embarcaci&#xF3;n corresponde a la n&#xFA;mero 1778 y no a la all&#xED; se&#xF1;alada.</div><br></div>", "i": 8045908}, {"t": "<div><div class=\"p\">&nbsp; &nbsp;  Valpara&#xED;so, 11 de julio de 2003.- Felipe Sandoval Precht, Subsecretario de Pesca.</div><br></div>", "i": 8045909}], "proyectos": [], "otrosSistemas": [], "jurisprudencia": [], "doctrina": [], "metadatos": {"tiene_notas": false, "tipos_numeros": [{"tipo": "3", "numero": "1605 EXENTA", "abreviacion": "RES", "descripcion": "Resolucion", "compuesto": "RES-1605 EXENTA"}], "organismos": ["MINISTERIO DE ECONOMÍA", "FOMENTO Y RECONSTRUCCION", "SUBSECRETARIA DE PESCA"], "titulo_norma": "", "fuente": "Diario Oficial", "resumenes": [], "materias": [], "terminos_libres": [], "categorias_norma": [], "nombres_uso_comun": [], "paises_tratados": [], "organismos_tratados": [], "observaciones": [], "derogacion_tacita": [], "derogado": true, "fecha_promulgacion": "2003-07-11", "fecha_derogacion": "2004-09-20", "doble_articulado": false, "id_norma": "212630", "numero_fuente": "37611", "tipo_version": "0", "tipo_version_s": "Texto Original", "fecha_publicacion": "2003-07-17", "vigencias": [{"desde": "2004-09-20", "hasta": "", "tipo_version": "2", "tipo_version_s": "Última Versión"}, {"desde": "2003-07-17", "hasta": "2004-09-19", "tipo_version": "0", "tipo_version_s": "Texto Original"}], "vigencia": {"inicio_vigencia": "2003-07-17", "fin_vigencia": "2004-09-19"}, "vigencias_version_norma": [{"inicio_vige