{"html": [{"t": "<div><div class=\"p\">EXTRACTO DE RESOLUCION N&#xBA; 930 EXENTA, DE 2001 </div><br></div>", "i": 6344353}, {"t": "<div><div class=\"p\">&nbsp; &nbsp;  Por resoluci&#xF3;n exenta del Ministerio de Transportes y Telecomunicaciones N&#xBA; 930 de 19.07.2001, se declara desierto el concurso p&#xFA;blico al segundo cuatrimestre de 2000.</div><br><div class=\"p\">&nbsp; &nbsp;  Regi&#xF3;n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;  Comuna</div><br><div class=\"p\">&nbsp; &nbsp;  Metropolitana&nbsp; &nbsp; Conchal&#xED;</div><div class=\"p\">&nbsp; &nbsp;  Metropolitana&nbsp; &nbsp; Curacav&#xED;</div><div class=\"p\">&nbsp; &nbsp;  Metropolitana&nbsp; &nbsp; Mar&#xED;a Pinto</div><div class=\"p\">&nbsp; &nbsp;  V&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Petorca</div><br><div class=\"p\">&nbsp; &nbsp;  La presente publicaci&#xF3;n se hace de acuerdo a lo dispuesto en el art&#xED;culo 13A inciso 6&#xBA; y 13B, de la ley N&#xBA; 18.168, Ley General de Telecomunicaciones, a objeto que quien tenga inter&#xE9;s en ello, pueda oponerse dentro del plazo de 5 d&#xED;as h&#xE1;biles, contados desde la presente publicaci&#xF3;n. La oposici&#xF3;n deber&#xE1; presentarse por escrito ante el Ministro de Transportes y Telecomunicaciones, ser fundada, adjuntar todos los medios de prueba que acrediten los hechos que la fundamentan y fijar domicilio dentro del radio urbano de la comuna de Santiago.-</div><br></div>", "i": 6344354}, {"t": "<div><div class=\"p\">&nbsp; &nbsp;  Subsecretar&#xED;a de Telecomunicaciones.</div><br></div>", "i": 6344355}], "proyectos": [], "otrosSistemas": [], "jurisprudencia": [], "doctrina": [], "metadatos": {"tiene_notas": false, "tipos_numeros": [{"tipo": "3", "numero": "930 EXENTA", "abreviacion": "RES", "descripcion": "Resolucion", "compuesto": "RES-930 EXENTA"}], "organismos": ["MINISTERIO DE TRANSPORTES Y TELECOMUNICACIONES", "SUBSECRETARIA DE TELECOMUNICACIONES"], "titulo_norma": "EXTRACTO DE RESOLUCION Nº 930 EXENTA, DE 2001", "fuente": "Diario Oficial", "resumenes": [], "materias": [], "terminos_libres": [], "categorias_norma": [], "nombres_uso_comun": [], "paises_tratados": [], "organismos_tratados": [], "observaciones": ["EXTRACTO"], "derogacion_tacita": [], "derogado": false, "fecha_promulgacion": "2001-07-19", "doble_articulado": false, "id_norma": "188093", "numero_fuente": "37025", "tipo_version": "0", "tipo_version_s": "Texto Original", "fecha_publicacion": "2001-07-31", "vigencias": [{"desde": "2001-08-01", "hasta": "", "tipo_version": "2", "tipo_version_s": "Última Versión"}, {"desde": "2001-07-31", "hasta": "2001-07-31", "tipo_version": "0", "tipo_version_s": "Texto Original"}], "vigencia": {"inicio_vigencia": "2001-07-31", "fin_vigencia": "2001-07-31"}, "vigencias_version_norma": [{"inicio_vigencia": "2001-07-31", "fin_vigencia": "2001-07-31", "tipo_version": "0"}, {"inicio_vigencia": "2001-08-01", "fin_vigencia": "", "tipo_version": "2"}], "eventos_pendientes": [], "vinculaciones": [{"text": "RECTIFICACION", "url_part": "rectificacion"}], "ingresado_por": "CNB", "fecha_ingreso": "2001-07-31", "fecha_version": "2001-07-31", "fecha_actualizacion_texto": "2001-08-01", "tipo_tratado": ""}, "alertas": [], "alerta_global": {"m": ["El texto de esta versión no se encuentra vigente"], "e": {"i": "188093", "p": "", "f": "2001-08-01", "t": "Ir al texto vigente"}}, "estructura": [{"n": "Encabezado", "i": 6344353}, {"n": "Artículo", "i": 6344354, "t": 6}, {"n": "Promulgación", "i": 6344355}]}