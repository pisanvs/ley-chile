{"html": [{"t": "<div><div class=\"p\">&nbsp; &nbsp; Ley n&#xFA;m. 9,850</div><div class=\"p\">&nbsp; &nbsp; MINISTERIO DE HACIENDA</div><div class=\"p\">&nbsp; &nbsp; (Publicada en el &quot;Diario Oficial&quot; N&#xB0; 21838, de 28 de diciembre de 1950).</div><div class=\"p\">&nbsp; &nbsp; LIBERA DE TODO DERECHO LA INTERNACION DE LOS EFECTOS NOTA 1 DE USO PERSONAL O DOMESTICO DE LAS MISIONES NAVAL Y AEREA DE LOS EE.UU. DE N.A.</div><div class=\"p\">&nbsp; &nbsp; Por cuanto el Congreso Nacional ha dado su aprobaci&#xF3;n al siguiente</div><div class=\"p\">&nbsp; &nbsp; Proyecto de ley:</div><br><div class=\"np\" id=\"np0\"><a href=\"#rnp0\">NOTA:&nbsp;  1</a> <br>&nbsp; &nbsp;  El art&#xED;culo &#xFA;nico de la ley 10014, declar&#xF3; que la palabra &quot;uso&quot; empleada en la ley 9850, es una expresi&#xF3;n gen&#xE9;rica que comprende por lo tanto, el consumo.<br></div></div>", "i": 8999654}], "proyectos": [], "otrosSistemas": [], "jurisprudencia": [], "doctrina": [], "metadatos": {"tiene_notas": true, "tipos_numeros": [{"tipo": "1", "numero": "9850", "abreviacion": "LEY", "descripcion": "Ley", "compuesto": "LEY-9850"}], "organismos": ["MINISTERIO DE HACIENDA"], "titulo_norma": "LIBERA DE TODO DERECHO LA INTERNACION DE LOS EFECTOS DE USO PERSONAL O DOMESTICO DE LAS MISIONES NAVAL Y AEREA DE LOS EE.UU. DE N.A.", "fuente": "", "resumenes": [], "materias": [], "terminos_libres": [], "categorias_norma": [], "nombres_uso_comun": [], "paises_tratados": [], "organismos_tratados": [], "observaciones": [], "derogacion_tacita": [], "derogado": false, "doble_articulado": false, "id_norma": "26249", "tipo_version": "1", "tipo_version_s": "Intermedio", "fecha_publicacion": "1950-12-28", "vigencias": [{"desde": "1951-10-20", "hasta": "", "tipo_version": "2", "tipo_version_s": "Última Versión"}, {"desde": "1951-10-19", "hasta": "1951-10-19", "tipo_version": "1", "tipo_version_s": "Intermedio"}], "vigencia": {"inicio_vigencia": "1951-10-19", "fin_vigencia": "1951-10-19"}, "vige