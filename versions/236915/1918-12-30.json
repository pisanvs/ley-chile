{"html": [{"t": "<div><div class=\"p\">&nbsp; &nbsp;  Lei n&#xFA;mero 3,460.- Por cuanto el Congreso Nacional ha dado su aprobaci&#xF3;n al siguiente</div><br><div class=\"p\">&nbsp; &nbsp;  PROYECTO DE LEI:</div><br></div>", "i": 9053197}, {"t": "<div><div class=\"p\">&nbsp; &nbsp;  Art&#xED;culo &#xFA;nico.- Se posterga el plazo fijado por la lei n&#xFA;mero 2,192, de 30 de agosto de 1909, para la conversion del papel moneda de curso forzoso, hasta el 31 de diciembre de 1919.</div><div class=\"p\">&nbsp; &nbsp;  Se postergan, igualmente, hasta el 31 de diciembre de 1919, los demas plazos consultados en la citada lei.</div><div class=\"p\">&nbsp; &nbsp;  Se prohibe la esportaci&#xF3;n del oro bajo pena de comiso.</div><div class=\"p\">&nbsp; &nbsp;  La presente lei comenzar&#xE1; a rejir desde su publicaci&#xF3;n en el Diario Oficial.</div><br></div>", "i": 9053198, "v": ["MODIFICACION"]}, {"t": "<div><div class=\"p\">&nbsp; &nbsp;  Y, por cuanto oido el Consejo de Estado, ha tenido a bien aprobarla y sancionarla; por tanto prom&#xFA;lguese y ll&#xE9;vese a efecto en todas sus partes como lei de la Rep&#xFA;blica.</div><div class=\"p\">&nbsp; &nbsp;  Santiago, treinta de diciembre de mil novecientos dieciocho.- Juan Luis Sanfuentes.- Luis Claro Solar. </div></div>", "i": 9053199}], "proyectos": [], "otrosSistemas": [], "jurisprudencia": [], "doctrina": [], "metadatos": {"tiene_notas": false, "tipos_numeros": [{"tipo": "1", "numero": "3460", "abreviacion": "LEY", "descripcion": "Ley", "compuesto": "LEY-3460"}], "organismos": ["MINISTERIO DE HACIENDA"], "titulo_norma": "", "fuente": "Diario Oficial", "resumenes": [], "materias": [], "terminos_libres": [], "categorias_norma": [], "nombres_uso_comun": [], "paises_tratados": [], "organismos_tratados": [], "observaciones": [], "derogacion_tacita": [], "derogado": false, "fecha_promulgacion": "1918-12-30", "doble_articulado": false, "id_norma": "236915", "tipo_version": "0", "tipo_version_s": "Texto Original", "fecha_publicacion": "1918-12-30", "vigencias": [{"desde": "1925-09-16", "hasta": "", "tipo_version": "2", "tipo_version_s": "Última Versión"}, {"desde": "1918-12-30", "hasta": "1925-09-15", "tipo_version": "0", "tipo_version_s": "Texto Original"}], "vigencia": {"inicio_vigencia": "1918-12-30", "fin_vigencia": "1925-09-15"}, "vigencias_version_norma": [{"inicio_vigencia": "1918-12-30", "fin_vigencia": "", "tipo_version": "3"}], "eventos_pendientes": [], "vinculaciones": [{"text": "MODIFICACION", "url_part": "modificacion"}], "ingresado_por": "CMV", "fecha_ingreso": "2005-04-11", "fecha_version": "1918-12-30", "fecha_actualizacion_texto": "1925-09-16", "tipo_tratado": ""}, "alertas": [], "alerta_global": {"m": ["El texto de esta versión no se encuentra vigente"], "e": {"i": "236915", "p": "", "f": "1925-09-16", "t": "Ir al texto vigente"}}, "estructura": [{"n": "Encabezado", "i": 9053197}, {"n": "Artículo UNICO", "i": 9053198, "t": 6}, {"n": "Promulgación", "i": 9053199}]}