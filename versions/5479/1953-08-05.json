{"html": [{"t": "<div><br></div>", "i": null}, {"t": "<div><br><div class=\"p\">&nbsp; &nbsp; Art&#xED;culo 19&#xB0;. El servicio de transporte a&#xE9;reo de pasajeros, carga y objetos postales queda reservado a las aeronaves y Empresas nacionales.</div><div class=\"p\">&nbsp; &nbsp; Si el propietario o empresario fuera una sociedad, se entender&#xE1; que es nacional para este efecto, cuando su capital pertenezca a chilenos en sus dos terceras partes al menos y sus administradores sean chilenos en igual proporci&#xF3;n.</div><br><br></div>", "i": 8988772}], "proyectos": [], "otrosSistemas": [], "jurisprudencia": [], "doctrina": [], "metadatos": {"tiene_notas": false, "tipos_numeros": [{"tipo": "13", "numero": "343", "abreviacion": "DFL", "descripcion": "DFL", "compuesto": "DFL-343"}], "organismos": ["MINISTERIO DE HACIENDA"], "titulo_norma": "DETERMINA ORGANIZACION Y ATRIBUCIONES DE LA SUBSECRETARIA DE TRANSPORTES", "fuente": "Diario Oficial", "resumenes": [], "materias": [], "terminos_libres": [], "categorias_norma": [], "nombres_uso_comun": [], "paises_tratados": [], "organismos_tratados": [], "observaciones": [], "derogacion_tacita": [], "derogado": false, "doble_articulado": false, "id_norma": "5479", "numero_fuente": "22615", "fecha_publicacion": "1953-08-05", "vigencias": [{"desde": "1962-01-05", "hasta": "", "tipo_version": "2", "tipo_version_s": "Última Versión"}, {"desde": "1953-11-10", "hasta": "1962-01-04", "tipo_version": "1", "tipo_version_s": "Intermedio"}, {"desde": "1953-08-05", "hasta": "1953-11-09", "tipo_version": "0", "tipo_version_s": "Texto Original"}], "vigencia": {"fin_vigencia": ""}, "vigencias_version_norma": [], "eventos_pendientes": [], "vinculaciones": [{"text": "MODIFICACION", "url_part": "modificacion"}, {"text": "CONCORDANCIA", "url_part": "concordancia"}, {"text": "REGLAMENTO", "url_part": "reglamento"}], "fecha_actualizacion_texto": "1962-01-05", "tipo_tratado": ""}, "alertas": [], "alerta_global": {"m": ["El texto de esta versión n