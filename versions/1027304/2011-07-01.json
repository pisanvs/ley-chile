{"html": [{"t": "<div><div class=\"p\">&#xA0;</div></div>", "i": 9155416}, {"t": "<div><br><div class=\"p\">&nbsp; &nbsp;  Por Decreto M.O.P. (EXENTO) N&#xBA;1292 de 31 de julio de 2011, se modific&#xF3; el numeral sexto de los Decretos MOP <a href=\"https://www.leychile.cl/Navegar?idNorma=1025464&amp;idParte=0&amp;idVersion=\">N&#xBA;622</a>, <a href=\"https://www.leychile.cl/Navegar?idNorma=1025465&amp;idParte=&amp;idVersion=\">623</a> y <a href=\"https://www.leychile.cl/Navegar?idNorma=1025466&amp;idParte=0&amp;idVersion=\">624</a> de 29 de abril de 2011, que ordenaron, la expropiaci&#xF3;n de los lotes N&#xBA;4D-1, 4-C1 y 11-B, respectivamente, en la parte que se refiere a la individualizaci&#xF3;n de la cuenta aporte, en donde dice 214051, debe decir 2140501 y no como se indic&#xF3; en dichos decretos. La publicaci&#xF3;n se efect&#xFA;a en cumplimiento a lo dispuesto en el art&#xED;culo 7&#xBA; del Decreto Ley N&#xBA;2186, de 1978. </div><br></div>", "i": 9155417, "v": ["MODIFICACION"]}, {"t": "<div><br><div class=\"p\">&nbsp; &nbsp;  Fiscal del Ministerio de Obras P&#xFA;blicas.</div></div>", "i": 9155418}], "proyectos": [], "otrosSistemas": [], "jurisprudencia": [], "doctrina": [], "metadatos": {"tiene_notas": false, "tipos_numeros": [{"tipo": "2", "numero": "1292 EXENTO", "abreviacion": "DTO", "descripcion": "Decreto", "compuesto": "Decreto-1292 EXENTO"}], "organismos": ["MINISTERIO DE OBRAS PÚBLICAS", "FISCALÍA"], "titulo_norma": "", "fuente": "", "resumenes": [], "materias": [], "terminos_libres": [], "categorias_norma": [], "nombres_uso_comun": [], "paises_tratados": [], "organismos_tratados": [], "observaciones": ["EXTRACTO"], "derogacion_tacita": [], "derogado": false, "fecha_promulgacion": "2011-07-31", "doble_articulado": false, "id_norma": "1027304", "tipo_version": "0", "tipo_version_s": "Texto Original", "fecha_publicacion": "2011-07-01", "vigencias": [{"desde": "2011-07-15", "hasta": "", "tipo_version": "2", "tipo_version_s": "Última Versión"}, {