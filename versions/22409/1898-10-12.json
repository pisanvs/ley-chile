{"html": [{"t": "<div><div class=\"p\">&nbsp; &nbsp; Lei n&#xFA;m. 1,100.- Por cuanto el Congreso Nacional ha prestado su aprobacion al siguiente</div><div class=\"p\">&nbsp; &nbsp; PROYECTO DE LEI:</div><br></div>", "i": 8845072}, {"t": "<div><div class=\"p\">&nbsp; &nbsp; Art&#xED;culo &#xFA;nico.- La Corte de Apelaciones de Santiago conocer&#xE1; de las causas del territorio de la provincia de Aconcagua, salvo las que se encuentren actualmente pendientes del conocimiento de la Corte de Apelaciones de Valparaiso.</div><br></div>", "i": 8845073}, {"t": "<div><div class=\"p\">&nbsp; &nbsp; I por cuanto, oido el Consejo de Estado, he tenido a bien aprobarlo i sancionarlo; por tanto prom&#xFA;lguese i ll&#xE9;vese a efecto como lei de la Rep&#xFA;blica.- Santiago, a ocho de octubre de mil ochocientos noventa i ocho.- FEDERICO ERRAZURIZ.- Carlos A. Palacios Z.</div><br></div>", "i": 8845074}], "proyectos": [], "otrosSistemas": [], "jurisprudencia": [], "doctrina": [], "metadatos": {"tiene_notas": false, "tipos_numeros": [{"tipo": "1", "numero": "1100", "abreviacion": "LEY", "descripcion": "Ley", "compuesto": "LEY-1100"}], "organismos": ["MINISTERIO DE JUSTICIA E INSTRUCCIÓN PÚBLICA"], "titulo_norma": "NUEVA JURISDICCION DE LA CORTE DE APELACIONES DE SANTIAGO", "fuente": "Diario Oficial", "resumenes": [], "materias": [], "terminos_libres": ["CORTE APELACIONES", "SANTIAGO", "PROVINCIA ACONCAGUA", "CAUSAS PENDIENTES", "VALPARAISO"], "categorias_norma": [], "nombres_uso_comun": [], "paises_tratados": [], "organismos_tratados": [], "observaciones": [], "derogacion_tacita": [], "derogado": false, "fecha_promulgacion": "1898-10-08", "doble_articulado": false, "id_norma": "22409", "numero_fuente": "6123", "tipo_version": "0", "tipo_version_s": "Texto Original", "fecha_publicacion": "1898-10-12", "vigencias": [{"desde": "1899-01-19", "hasta": "", "tipo_version": "2", "tipo_version_s": "Última Versión"}, {"desde": "1898-10-13", "hasta": "1899-01-18", "tipo_version": "1", "tipo_v