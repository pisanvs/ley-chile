{"html": [{"t": "<div><div class=\"p\">&nbsp; &nbsp;  Lei n&#xFA;mero 3,830.- Por cuanto el Congreso Nacional ha dado su aprobacion al siguiente</div><br><div class=\"p\">&nbsp; &nbsp;  PROYECTO DE LEI:</div><br></div>", "i": 8810113}, {"t": "<div><div class=\"p\">&nbsp; &nbsp;  Art&#xED;culo &#xFA;nico.- Autor&#xED;zase a la Empresa de los Ferrocarriles del Estado para contratar en las instituciones de cr&#xE9;dito nacional una cuenta corriente por la suma de veinte millones de pesos ($ 20,000,000) moneda corriente, que destinar&#xE1; a cancelar las cuentas pendientes del ejercicio financiero del a&#xF1;o 1921.</div><br></div>", "i": 8810114}, {"t": "<div><div class=\"p\">&nbsp; &nbsp;  Y por cuanto, oido el Consejo de Estado, he tenido a bien aprobarlo y sancionarlo; por tanto, prom&#xFA;lguese y ll&#xE9;vese a efecto como lei de la Rep&#xFA;blica.</div><div class=\"p\">&nbsp; &nbsp;  Santiago, a cinco de enero de mil novecientos veintidos.- Arturo Alessandri.- Armando Jaramillo V. </div></div>", "i": 8810115}], "proyectos": [], "otrosSistemas": [], "jurisprudencia": [], "doctrina": [], "metadatos": {"tiene_notas": false, "tipos_numeros": [{"tipo": "1", "numero": "3830", "abreviacion": "LEY", "descripcion": "Ley", "compuesto": "LEY-3830"}], "organismos": ["MINISTERIO DE FERROCARRILES"], "titulo_norma": "", "fuente": "Diario Oficial", "resumenes": [], "materias": [], "terminos_libres": [], "categorias_norma": [], "nombres_uso_comun": [], "paises_tratados": [], "organismos_tratados": [], "observaciones": ["LA PRESENTE NORMA FUE PUBLICADA NUEVAMENTE EN EL D.O. 29.08.1923"], "derogacion_tacita": [], "derogado": false, "fecha_promulgacion": "1922-01-05", "doble_articulado": false, "id_norma": "143442", "numero_fuente": "13169", "tipo_version": "0", "tipo_version_s": "Texto Original", "fecha_publicacion": "1922-01-06", "vigencias": [{"desde": "1922-05-01", "hasta": "", "tipo_version": "2", "tipo_version_s": "Última Versión"}, {"desde": "1922-01-06", "hasta": "1922-04-30