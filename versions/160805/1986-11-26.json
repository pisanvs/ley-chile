{"html": [{"t": "<div><div class=\"p\">DESIGNA COMO RECEPTORES JUDICIALES A FUNCIONARIOS QUE INDICA</div><br><div class=\"p\">(Resoluci&#xF3;n)</div><br><div class=\"p\">&nbsp; &nbsp;  N&#xFA;m. 89.- Santiago, 23 de Octubre de 1986.- Vistos: Lo dispuesto en el art&#xED;culo 11 del Decreto Ley N&#xBA; 2.974 de 1979,</div><br><div class=\"p\">&nbsp; &nbsp;  Resuelvo:</div><br></div>", "i": 8972885}, {"t": "<div><div class=\"p\">&nbsp; &nbsp;  Des&#xED;gnase como Receptores Judiciales para que permanentemente practiquen las actuaciones inherentes a ese cargo en los juicios que se tramitan ante los Juzgados de Polic&#xED;a Local, en conformidad a las disposiciones del Decreto Ley citado, en la IV Regi&#xF3;n, a los se&#xF1;ores:</div><br><div class=\"p\">- Juan Segundo Valdivia Monta&#xF1;o - Manuel Eduardo Oyarz&#xFA;n Cer&#xF3;n </div></div>", "i": 8972886}, {"t": "<div><div class=\"p\">&nbsp; &nbsp;  T&#xF3;mese raz&#xF3;n, an&#xF3;tese, comun&#xED;quese y publ&#xED;quese en el Diario Oficial.- Arturo Venegas Palacios, Vicepresidente Ejecutivo.</div><br></div>", "i": 8972887}], "proyectos": [], "otrosSistemas": [], "jurisprudencia": [], "doctrina": [], "metadatos": {"tiene_notas": false, "tipos_numeros": [{"tipo": "3", "numero": "89", "abreviacion": "RES", "descripcion": "Resolucion", "compuesto": "RES-89"}], "organismos": ["MINISTERIO DE AGRICULTURA", "INSTITUTO DE DESARROLLO AGROPECUARIO"], "titulo_norma": "DESIGNA COMO RECEPTORES JUDICIALES A FUNCIONARIOS QUE\nINDICA", "fuente": "Diario Oficial", "resumenes": [], "materias": [], "terminos_libres": [], "categorias_norma": [], "nombres_uso_comun": [], "paises_tratados": [], "organismos_tratados": [], "observaciones": [], "derogacion_tacita": [], "derogado": false, "fecha_promulgacion": "1986-10-23", "doble_articulado": false, "id_norma": "160805", "numero_fuente": "32632", "tipo_version": "0", "tipo_version_s": "Texto Original", "fecha_publicacion": "1986-11-26", "vigencias": [{"desde": "2000-05-10", "hasta": "", "t