{"html": [{"t": "<div><div class=\"p\">&nbsp; &nbsp; LEY NUM. 6,152 ARRENDAMIENTO DE TIERRAS FISCALES UBICADAS EN MAGALLANES</div><div class=\"p\">&nbsp; &nbsp; (Publicada en el &quot;Diario Oficial&quot; N&#xB0; 17,970, de 19 de enero de 1938)</div><div class=\"p\">&nbsp; &nbsp; Por cuanto el Congreso Nacional ha dado su aprobaci&#xF3;n al siguiente</div><div class=\"p\">&nbsp; &nbsp; Proyecto de Ley:</div><br><div class=\"np\" id=\"np0\"><a href=\"#rnp0\">NOTA:&nbsp; 1</a> <br>&nbsp; &nbsp;  Con fecha 21 de junio de 1938 se public&#xF3; el D. S.<br>N&#xB0; 80 del Ministerio de Tierras y Colonizaci&#xF3;n, y cuya suma dice: &quot;Fija el Texto Definitivo de la Ley N&#xB0; 6152 sobre Arrendamiento de Bienes Ra&#xED;ces Fiscales&quot;. Sin embargo, de la lectura de los considerandos de dicho decreto supremo y del art&#xED;culo 58 de la presente ley, habr&#xED;a que entender que el D. S. 80, de 1938, fij&#xF3; el texto definitivo del art&#xED;culo 57 de la presente ley.<br></div></div>", "i": 9093256}], "proyectos": [], "otrosSistemas": [], "jurisprudencia": [], "doctrina": [], "metadatos": {"tiene_notas": true, "tipos_numeros": [{"tipo": "1", "numero": "6152", "abreviacion": "LEY", "descripcion": "Ley", "compuesto": "LEY-6152"}], "organismos": ["MINISTERIO DE TIERRAS Y COLONIZACIÓN"], "titulo_norma": "ARRENDAMIENTO DE TIERRAS FISCALES UBICADAS EN MAGALLANES", "fuente": "Diario Oficial", "resumenes": [], "materias": [], "terminos_libres": [], "categorias_norma": [], "nombres_uso_comun": [], "paises_tratados": [], "organismos_tratados": [], "observaciones": [], "derogacion_tacita": [], "derogado": false, "fecha_promulgacion": "1937-12-31", "doble_articulado": false, "id_norma": "25299", "numero_fuente": "17970", "tipo_version": "1", "tipo_version_s": "Intermedio", "fecha_publicacion": "1938-01-19", "vigencias": [{"desde": "1985-08-11", "hasta": "", "tipo_version": "2", "tipo_version_s": "Última Versión"}, {"desde": "1972-08-14", "hasta": "1985-08-10", "tipo_version": "