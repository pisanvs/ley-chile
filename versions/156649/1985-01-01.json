{"html": [{"t": "<div><div class=\"p\">DETERMINA FACTORES DE REAJUSTE 1985 Y MONTOS DE BONIFICACIONES COMPENSATORIAS - ART. 34, LEY N&#xB0; 18.382 </div><div class=\"p\">&nbsp; &nbsp;  N&#xFA;m. 9.- Santiago, 4 de Enero de 1985.</div><div class=\"p\">&nbsp; &nbsp;  Que el Instituto Nacional de Estad&#xED;sticas ha fijado en 23 la variaci&#xF3;n acumulada durante el a&#xF1;o 1984 del Indice de Precios al Consumidor.</div><div class=\"p\">&nbsp; &nbsp;  Que de acuerdo con lo anterior los porcentajes del 75%, 60% y 40% de dicha variaci&#xF3;n corresponden a 17, 25, 13, 8 y 9, 2 respectivamente.</div><div class=\"p\">&nbsp; &nbsp;  Visto: Lo dispuesto en el art&#xED;culo 34 de la Ley N&#xB0; 18.382 y el art&#xED;culo 70 del DL N&#xB0; 1.263, de 1975.</div><br><div class=\"p\">&nbsp; &nbsp;  Decreto:</div><br></div>", "i": 9010169}], "proyectos": [], "otrosSistemas": [], "jurisprudencia": [], "doctrina": [], "metadatos": {"tiene_notas": false, "tipos_numeros": [{"tipo": "2", "numero": "9", "abreviacion": "DTO", "descripcion": "Decreto", "compuesto": "DTO-9"}], "organismos": ["MINISTERIO DE HACIENDA", "SUBSECRETARÍA DE HACIENDA"], "titulo_norma": "DETERMINA FACTORES DE REAJUSTE 1985 Y MONTOS DE\nBONIFICACIONES COMPENSATORIAS - ART. 34, LEY N° 18.382", "fuente": "Diario Oficial", "resumenes": [], "materias": [], "terminos_libres": [], "categorias_norma": [], "nombres_uso_comun": [], "paises_tratados": [], "organismos_tratados": [], "observaciones": [], "derogacion_tacita": [], "derogado": false, "fecha_promulgacion": "1985-01-04", "doble_articulado": false, "id_norma": "156649", "numero_fuente": "32065", "tipo_version": "0", "tipo_version_s": "Texto Original", "fecha_publicacion": "1985-01-08", "vigencias": [{"desde": "1985-01-08", "hasta": "", "tipo_version": "2", "tipo_version_s": "Última Versión"}, {"desde": "1985-01-01", "hasta": "1985-01-07", "tipo_version": "0", "tipo_version_s": "Texto Original"}], "vigencia": {"inicio_vigencia": "1985-01-01", "fin_vigencia": "1985-